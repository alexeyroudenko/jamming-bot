# Build from repo root: docker build -f services-map/Dockerfile.prod -t services-map:latest .
FROM node:22-alpine AS build
WORKDIR /app
COPY services-map/package.json services-map/package-lock.json ./services-map/
RUN cd services-map && npm install
COPY services-map/ ./services-map/
COPY scripts/generate-services-graph.mjs ./scripts/
COPY deployment.yaml ./deployment.yaml
RUN cd services-map && npm run build

FROM nginx:1.27-alpine
COPY services-map/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/services-map/dist /usr/share/nginx/html
EXPOSE 80
